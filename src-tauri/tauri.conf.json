{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Cycle Timer",
  "version": "0.1.0",
  "identifier": "com.codex.studycycletimer",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.js",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Study Cycle Timer",
        "width": 420,
        "height": 560,
        "minWidth": 320,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
